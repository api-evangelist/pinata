          "name": "Upload a file",
          "request": {
            "name": "Upload a file",
            "description": {
              "content": "Uploads a file to Pinata, pinning it to either the public IPFS\nnetwork or to private storage depending on the `network` parameter.\nThis endpoint is served from uploads.pinata.cloud.\n",
              "type": "text/plain"
            },
            "url": {
              "protocol": "https",
              "path": [
                "v3",
                "files"
              ],
